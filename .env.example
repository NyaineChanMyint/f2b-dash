# Generate a strong value, for example: openssl rand -hex 32
F2B_API_TOKEN=replace-with-a-long-random-secret
F2B_ADMIN_USERNAME=admin
F2B_ADMIN_PASSWORD=replace-with-a-unique-12-character-minimum-password
# Set to true after serving the dashboard through HTTPS.
F2B_COOKIE_SECURE=false
# The host port exposed by Nginx. Use 8080 when port 80 is occupied.
HTTP_PORT=80
